<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- ============================================================
         PERMISSIONS
         ============================================================ -->

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Notifications -->
    <!-- VIBRATE: legacy haptic on pre-26 channels; still required on <26. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- POST_NOTIFICATIONS: runtime permission, Android 13+ (API 33). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WAKE_LOCK: used by FCM's onMessageReceived when the device is dozing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- RECEIVE_BOOT_COMPLETED: required for MedVixBootReceiver to restore
         scheduled reminders after reboot and after Play Store updates
         (MY_PACKAGE_REPLACED). Was previously stripped with tools:node="remove";
         removed that directive here because the boot receiver needs it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 🚫 Unused system permissions — removed from merged manifest.
         These are auto-injected by plugins but MedVix does not use them.
         NOTE: RECEIVE_BOOT_COMPLETED deliberately excluded from this list
         now that MedVixBootReceiver depends on it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />

    <!-- Runtime (Dangerous) permissions – requested at runtime -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Storage permissions (Android 12 and below) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- DownloadManager support -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <!-- ============================================================
         APPLICATION
         ============================================================ -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">
        <!-- ===== Main Activity ===== -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.NoActionBarLaunch">
            <!-- Launcher (app icon) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ===== App Links for medvix.co.ke ===== -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.medvix.co.ke" />
                <data android:scheme="https" android:host="www.app.medvix.co.ke" />
            </intent-filter>

            <!-- ===== Custom scheme for OAuth redirects ===== -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.medvix.co.ke" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.app.medvix.co.ke" />
            </intent-filter>

            <!--
                External-file "Open with" intent filters have been removed.
                MedVix no longer appears in the OS chooser when the user taps
                a PDF, image, or .txt file in Files, Gmail, Chrome, Drive, or
                any other app.

                The FileOpenPlugin is still installed and MainActivity still
                forwards any ACTION_VIEW intents it receives to it. But with
                no matching intent-filter, the OS will never launch MedVix
                this way. The plugin simply never receives a URI, and
                viewer.js's `_wireNativeFileOpen` handshake stays idle.

                To re-enable external file opening later, restore the three
                intent-filter blocks below.

                <intent-filter>
                    <action android:name="android.intent.action.VIEW" />
                    <category android:name="android.intent.category.DEFAULT" />
                    <category android:name="android.intent.category.BROWSABLE" />
                    <data android:mimeType="application/pdf" />
                </intent-filter>

                <intent-filter>
                    <action android:name="android.intent.action.VIEW" />
                    <category android:name="android.intent.category.DEFAULT" />
                    <category android:name="android.intent.category.BROWSABLE" />
                    <data android:mimeType="image/*" />
                </intent-filter>

                <intent-filter>
                    <action android:name="android.intent.action.VIEW" />
                    <category android:name="android.intent.category.DEFAULT" />
                    <category android:name="android.intent.category.BROWSABLE" />
                    <data android:mimeType="text/plain" />
                </intent-filter>
            -->
        </activity>

        <!-- ===== Native document viewer Activity =====
             Hosted by com.medhurb.app.viewer.ui.MedvixPdfActivity and launched
             from Java (MedvixPdfViewerPlugin.openDocument / FileOpenPlugin) via
             startActivityForResult(). It is NOT exported: only our own code
             starts it, so no intent-filters are required — but Android still
             refuses to launch any Activity that is absent from the manifest.
             Without this entry the launch throws
             ActivityNotFoundException inside the Capacitor plugin, the JS call
             rejects immediately, resource-browser.js restores its Open button,
             and the user sees the spinner start and stop with no viewer UI.

             configChanges mirrors MainActivity so rotation / dark-mode / split-
             screen changes never recreate the Activity (which would reload the
             whole PdfRenderer document). No explicit theme: the application's
             AppTheme (a Theme.AppCompat descendant) applies, which is required
             because MedvixPdfActivity extends AppCompatActivity. -->
        <activity
            android:name="com.medhurb.app.viewer.ui.MedvixPdfActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleTop" />

        <!-- ===== File provider for sharing/printing PDFs ===== -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- ============================================================
             MedVix Notification Subsystem
             ============================================================ -->
        <!-- Fires when a reminder alarm scheduled by MedVixNotifications
             elapses. Sends the notification using the medvix_general
             channel. Not exported: alarms are delivered by AlarmManager
             from our own UID, no other app needs to trigger this.
             Class body lands in Checkpoint 3. -->
        <receiver
            android:name=".MedVixNotificationReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Fires on device boot and on Play Store in-place update.
             Both events clear AlarmManager, so the receiver re-reads
             persisted reminders from SharedPreferences and re-schedules
             anything whose fire time is still in the future.
             BOOT_COMPLETED and MY_PACKAGE_REPLACED are protected system
             broadcasts — delivered even though exported="false".
             Class body lands in Checkpoint 3. -->
        <receiver
            android:name=".MedVixBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Firebase Cloud Messaging entry point. Invoked by the Firebase
             SDK (via its own internal process registration) when a push
             arrives for this app. Not exported: only Firebase/system
             delivers MESSAGING_EVENT. Class body lands in Checkpoint 3. -->
        <service
            android:name=".MedVixFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

    <!-- ============================================================
         QUERIES (required on Android 11+ for package visibility)
         ============================================================ -->

    <queries>
        <intent>
            <action android:name="com.google.android.gms.auth.api.signin.ACTION_GOOGLE_SIGN_IN" />
        </intent>

        <package android:name="com.google.android.gms" />

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>

        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>

        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>

        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>

        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>

        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
</manifest>